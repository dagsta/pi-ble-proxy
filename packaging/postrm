#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    rm -f /etc/avahi/services/pi-ble-proxy.service
    [ -d /run/systemd/system ] && systemctl daemon-reload || true
fi
if [ "$1" = purge ]; then
    rm -rf /etc/pi-ble-proxy
    deluser --quiet --system bleproxy 2>/dev/null || true
fi
exit 0
